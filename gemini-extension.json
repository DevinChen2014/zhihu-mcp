{
  "name": "socialdatax-zhihu",
  "version": "1.0.0",
  "description": "SocialDataX: Zhihu/知乎 hot list;answer/article/video search/details;comments/replies;creators/articles;transcript.",
  "mcpServers": {
    "socialdatax-zhihu": {
      "httpUrl": "https://mcp.socialdatax.com/zhihu/mcp",
      "headers": {
        "Authorization": "Bearer ${SOCIALDATAX_API_KEY}"
      },
      "timeout": 300000
    }
  },
  "settings": [
    {
      "name": "SocialDataX API Key",
      "description": "Get your own API Key at https://socialdatax.com/ai?from=gemini-cli. Business calls consume SocialDataX credits.",
      "envVar": "SOCIALDATAX_API_KEY",
      "sensitive": true
    }
  ]
}
